# SPTrans (Olho Vivo) API Token
# Get yours at: http://olhovivo.sptrans.com.br/desenvolvedores
SPTRANS_TOKEN=your_sptrans_token_here

# Google Maps / Places API Key
# Get yours at: https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# SQL Server connection (Windows Authentication example)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\\SQLEXPRESS
DB_NAME=ColetaTransporte
DB_TRUSTED=yes

# Optional: Kaggle credentials (if using kagglehub)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
